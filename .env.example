# Database Configuration
DATABASE_URL=postgresql://user:password@host:port/database

# Brevo Email Service (SMTP)
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=orders@vectorwiz.com
BREVO_SENDER_NAME=VectorWiz Team

# AI Services
OPENAI_API_KEY=your-openai-api-key-here
STABILITY_AI_API_KEY=your-stability-ai-api-key-here
REPLICATE_API_TOKEN=your-replicate-api-token-here

# Server Configuration (Optional)
PORT=5000
HOST=localhost
NODE_ENV=development

# Subpath Deployment (Optional)
# Set this if deploying at a subpath, e.g., abc.com/tools -> VITE_BASE_PATH=/tools/
# VITE_BASE_PATH=/tools/
# BASE_PATH=/tools

